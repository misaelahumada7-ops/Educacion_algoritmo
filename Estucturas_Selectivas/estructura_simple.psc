Algoritmo Selectiva_simple
	//averiguar el mayor de 2 numeros
	definir n1,n2 Como Real;
	mostrar"ingrese el n1";
	leer n1;
	mostrar "ingrese el n2";
	leer n2;
	si n1>n2 Entonces
		mostrar"el numero ",n1," es mayor que ",n2;
	FinSi
	si n2>n1 Entonces
		mostrar"el numero ",n2," es mayor que ",n1;
	FinSi
	
FinAlgoritmo
